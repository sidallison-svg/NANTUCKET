# NANTUCKET Environment Variables
# ─────────────────────────────────────────────────────────
# INSTRUCTIONS:
#   1. Copy this file: cp .env.example .env
#   2. Fill in your actual API key in .env
#   3. Never commit .env — it's already in .gitignore
#
# Load before running: source .env
# ─────────────────────────────────────────────────────────

# Required for: nantucket explain, nantucket bull-bear, /market AI story
# Get your key at: https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional: override the Claude model used for analysis
# Default is claude-sonnet-4-5
# NANTUCKET_MODEL=claude-sonnet-4-5

# Optional: live economic indicators on the /market tab (CPI, unemployment, etc.)
# Get a free key at: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=your-fred-key-here
