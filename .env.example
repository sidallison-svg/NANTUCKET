# NANTUCKET Environment Variables
# ─────────────────────────────────────────────────────────
# INSTRUCTIONS:
#   1. Copy this file: cp .env.example .env
#   2. Fill in your actual API keys in .env
#   3. Never commit .env — it's already in .gitignore
#
# Load before running: source .env
#   Or add the exports to your ~/.zshrc so they're always set.
# ─────────────────────────────────────────────────────────

# Required for stock quotes (price auto-fill, market data)
# Get your free key at: https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_KEY=your-alpha-vantage-key-here

# Optional: economic calendar data (FRED)
# Get your free key at: https://fred.stlouisfed.org/docs/api/api_key.html
# FRED_API_KEY=your-fred-key-here

# Required for: nantucket explain, nantucket bull-bear
# Get your key at: https://console.anthropic.com
# ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional: override the Claude model used for analysis
# Default is claude-sonnet-4-5
# NANTUCKET_MODEL=claude-sonnet-4-5
